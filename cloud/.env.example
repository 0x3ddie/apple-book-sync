# Public HTTPS origin, without a path. No preview URL inference.
BETTER_AUTH_URL=https://your-books-app.example
# Generate a cryptographically random secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Use the provider's TLS-enabled Postgres connection string.
DATABASE_URL=
RESEND_API_KEY=
# A sender on your verified Resend domain.
EMAIL_FROM=Books <reading@your-domain.example>
